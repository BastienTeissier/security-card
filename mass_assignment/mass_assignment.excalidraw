      "isDeleted": false,
      "boundElements": [],
      "updated": 1770199292006,
      "link": null,
      "locked": false,
      "text": "The backend serializes the request\nbody into a DTO (intermediary\nobject to handle data) removing\nthe tinkered parameter",
